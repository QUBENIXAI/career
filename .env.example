# Google Apps Script Web App that stores applications (see apps-script/README.md).
# The /exec URL from Deploy → Manage deployments.
APPS_SCRIPT_WEB_APP_URL=
# The SHARED_SECRET that setup() logs in the Apps Script editor. Server-side only — never NEXT_PUBLIC_.
APPS_SCRIPT_SHARED_SECRET=
# Optional: separate key for signing the form's anti-spam token. Defaults to APPS_SCRIPT_SHARED_SECRET.
CAREERS_FORM_SECRET=
